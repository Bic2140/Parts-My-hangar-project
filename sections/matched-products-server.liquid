{% assign handles_string = request.params.handles %}
{% assign handles = handles_string | split: ',' %}

<div class="debug-output" style="padding: 1em; background: #f3f3f3; border: 1px solid #ccc; font-size: 14px;">
  <strong>🛠 Debug: matched-products-server</strong><br>
  <strong>🔍 Handles param:</strong> {{ handles_string }}<br>
  <strong>🔍 Parsed handles ({{ handles.size }}):</strong> {{ handles | join: ', ' }}
</div>

{% for handle in handles %}
  {% assign product = all_products[handle] %}
  {% if product %}
    {% render 'card-product', product: product %}
  {% else %}
    <div class="text-sm text-red-500">❌ Product not found: {{ handle }}</div>
  {% endif %}
{% endfor %}
