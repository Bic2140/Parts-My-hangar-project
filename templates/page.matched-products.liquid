{% section 'main-page' %}  {%- comment -%} or replace with your default content section name {%- endcomment -%}

{% assign handles = request.body.handles | split: ',' %}

<div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
  {% for handle in handles %}
    {% assign product = all_products[handle] %}
    {% if product %}
      <div class="grid__item">
        {% render 'product-card', product: product %}
      </div>
    {% endif %}
  {% endfor %}
</div>

<script src="{{ 'matched-parts.js' | asset_url }}" defer></script>
